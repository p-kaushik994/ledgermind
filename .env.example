# LedgerMind Configuration
# Groq API Key (Get free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Vectorize Hindsight API Key & Endpoint (Get free at https://ui.hindsight.vectorize.io)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io/v1

# Groq Model (default to fast and capable model)
GROQ_MODEL=llama-3.3-70b-versatile

# Set to True to run with simulated LLM & Hindsight memory responses without API keys
MOCK_MODE=true

# Server Port
PORT=5000
